# Network Guru - secrets on the site server: /opt/networkguru/secrets/secrets.env (mode 600)
#
# Do NOT fill this file in by hand on a PC. install.sh asks for each value with hidden input
# and writes the real file on the server:   sudo bash deploy/install.sh --secrets
# Plain KEY=VALUE, one per line, read by Network Guru itself ($ and quotes need no escaping).
# (The developer install from git reads dev-secrets/secrets.env instead, filled in by hand on the
# test PC - see deploy/WINDOWS_TEST.md, Way A, step A7.)
#
# Optional GitHub token for the daily update check - not needed, the repository is public. If you
# use one: fine-grained, only Quesito350/Network-Guru, Contents read-only.
NETWORKGURU_GITHUB_TOKEN=
#
# Admin password, as a scrypt hash (install.sh makes it - never the password itself)
NETWORKGURU_ADMIN_PASSWORD_HASH=
#
# Morning report to Teams: the URL of a Teams Workflows flow "When a Teams webhook request is received"
NETWORKGURU_TEAMS_WEBHOOK_URL=
#
# Morning report e-mail through Microsoft 365: client secret of the Entra app (Mail.Send, application
# permission, limited to the sender mailbox). Tenant, app ID and sender are set on the admin page.
NETWORKGURU_GRAPH_CLIENT_SECRET=
#
# ...or through an SMTP server (host, port, sender on the admin page)
NETWORKGURU_SMTP_USER=
NETWORKGURU_SMTP_PASSWORD=
#
# Device logins for the readers (0.7.0), by the names the inventory uses. install.sh --secrets asks for each:
#   RAJANT_SNMP_USER / RAJANT_SNMP_AUTH / RAJANT_SNMP_PRIV   Rajant SNMP v3 user, auth and privacy passwords
#   TACHYON_SNMP_RO, SWITCH_SNMP_RO                          read-only SNMP communities
