# Network Guru test install (compose.yaml next to this file).
# Copy this file to .env and change what you need. No secrets here - they go in
# dev-secrets/secrets.env (see deploy/WINDOWS_TEST.md). The site's inventory.yaml goes in the
# "site" folder next to compose.yaml (without it, the demo site is shown).
#
# Which published image: empty = the newest (latest), or a version such as 0.5.4
NG_TAG=
#
# The dashboard port on this PC (8081 if an install.sh install already uses 8080)
NG_PORT=8080
#
# sim = simulated devices on the real layout (until the 0.6.0 drivers), live = real polling
NG_MODE=sim
#
# The address other PCs open - used for the link in the morning report, e.g. http://10.200.1.50:8080/
NG_PUBLIC_URL=
#
# Docker network for the two containers (empty = 172.29.251.0/24); change it only if the site uses it
NG_SUBNET=
